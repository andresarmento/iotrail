{
    // IntelliSense da extensao C/C++ (ms-vscode.cpptools). Sem este arquivo ela
    // roda no default, que nao conhece nem o include path do projeto nem o
    // compilador do MSYS2 - dai o "logging.h nao encontrado" e o mesmo aviso
    // nos headers do spdlog.
    "version": 4,
    "configurations": [
        {
            "name": "IoTrail (MSYS2 ucrt64)",

            // Fonte principal: a linha de compilacao real de cada .cpp, gerada
            // pelo CMAKE_EXPORT_COMPILE_COMMANDS. E' o que mantem o
            // IntelliSense em dia sozinho - flag ou include novo no
            // CMakeLists.txt chega aqui no proximo configure, sem editar isto.
            // O arquivo esta em build/, que e' gerado e nao vai pro git:
            // rodar `cmake -S . -B build -G Ninja` uma vez o cria.
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",

            // Fallback pra antes do primeiro configure (e pra arquivo que ainda
            // nao esta no CMakeLists.txt): sem isto, num clone novo o
            // IntelliSense fica cego ate alguem buildar.
            "includePath": [
                "${workspaceFolder}/src"
            ],

            // De onde saem os headers de sistema e da libstdc++. Sem apontar o
            // compilador, a extensao tenta o MSVC e nao acha nem <memory>.
            "compilerPath": "C:/msys64/ucrt64/bin/g++.exe",
            "intelliSenseMode": "windows-gcc-x64",
            "cStandard": "c17",
            "cppStandard": "c++17"
        }
    ]
}
